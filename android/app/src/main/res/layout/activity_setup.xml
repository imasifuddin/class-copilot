<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="26dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="20dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/fg"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_blurb"
            android:textColor="@color/dim"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.35"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="6dp"
            android:text="@string/label_host"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:letterSpacing="0.06" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field"
            android:padding="14dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/dim"
            android:textSize="16sp"
            android:hint="@string/hint_host"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="@string/label_pin"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:letterSpacing="0.06" />

        <EditText
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field"
            android:padding="14dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/dim"
            android:textSize="26sp"
            android:letterSpacing="0.35"
            android:gravity="center"
            android:hint="@string/hint_pin"
            android:inputType="number"
            android:maxLength="6"
            android:importantForAutofill="no"
            android:singleLine="true" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/button"
            android:padding="14dp"
            android:text="@string/connect"
            android:textAllCaps="false"
            android:textColor="#04121F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="30dp"
            android:textColor="@color/bad"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>

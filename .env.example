# Copy this file to .env and fill in the key for whichever provider you use.
# You can also set keys from the app's settings screen on your phone -- those
# are saved to settings.json and take priority over anything here.

# ---- Claude (default) ----
# Key from https://console.anthropic.com  ->  API keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- the others, all optional ----
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...              # free tier at aistudio.google.com
# GROQ_API_KEY=gsk_...            # free tier at console.groq.com
# OPENROUTER_API_KEY=sk-or-...

# Only needed for provider = "custom" (LM Studio, vLLM, Together, ...).
# Every built-in provider already knows its own URL.
# OPENAI_BASE_URL=http://localhost:1234/v1

# Ollama needs no key at all -- just pick it in the settings screen.
